fragment_id = "memory_03"
fragment_title = "碎片 03：树后的目光"
fragment_line = "村民：看见她偏离道路，就告诉别人；这不是恶意，是规矩。"
fragment_style = 2
voice_clip = ExtResource("15_mem03")
subtitle_duration = 5.2

[node name="Memory_Hunter" parent="Collectibles/MemoryFragments" instance=ExtResource("12_memory")]
