[node name="HowToPlayText" type="RichTextLabel" parent="SafeArea/ModalOverlay/Center/ModalPanel/Margin/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 284)
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_colors/default_color = Color(0.86, 0.84, 0.81, 1)
theme_override_colors/font_selected_color = Color(0.86, 0.84, 0.81, 1)
theme_override_fonts/normal_font = ExtResource("4_font")
theme_override_fonts/bold_font = ExtResource("4_font")
theme_override_font_sizes/normal_font_size = 16
theme_override_font_sizes/bold_font_size = 16
bbcode_enabled = true
text = "[color=#f1c27d][b]YOUR TASK[/b][/color]\nRecover all six memory fragments. Each object reveals part of the truth and changes the forest.\n\n[color=#f1c27d][b]SURVIVE[/b][/color]\nWolves pause before a straight lunge. Move sideways and use trees, stones, and walls as cover. Damage reduces both health and sanity.\n\n[color=#f1c27d][b]FIND THE ROAD[/b][/color]\nThe safe-looking front door is a trap. When the truth is restored, return to the Broken Signpost and follow the red thread.\n\n[color=#928b88]Touch controls appear inside the game. Open BAG to review every collected memory.[/color]"
fit_content = true

