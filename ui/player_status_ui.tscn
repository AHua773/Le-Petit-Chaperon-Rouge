[gd_scene format=3]

[ext_resource type="Script" path="res://ui/player_status_ui.gd" id="1_script"]
[ext_resource type="FontFile" path="res://assets/fonts/NotoSansCJKsc-Regular.otf" id="2_chinese_font"]

[sub_resource type="Shader" id="Shader_screen_blur"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform float blur_strength = 0.0;

void fragment() {
	vec2 offset = SCREEN_PIXEL_SIZE * blur_strength;
	vec4 center = texture(screen_texture, SCREEN_UV);
	vec4 blur = center * 0.227027;
	blur += texture(screen_texture, SCREEN_UV + vec2(offset.x, 0.0)) * 0.1945946;
	blur += texture(screen_texture, SCREEN_UV - vec2(offset.x, 0.0)) * 0.1945946;
	blur += texture(screen_texture, SCREEN_UV + vec2(0.0, offset.y)) * 0.1945946;
	blur += texture(screen_texture, SCREEN_UV - vec2(0.0, offset.y)) * 0.1945946;
	COLOR = mix(center, blur, clamp(blur_strength / 6.0, 0.0, 1.0));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_screen_blur"]
shader = SubResource("Shader_screen_blur")
shader_parameter/blur_strength = 0.0

