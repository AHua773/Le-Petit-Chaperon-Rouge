[sub_resource type="Shader" id="Shader_safe_filter"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear;
uniform float intensity : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 scene = texture(screen_texture, SCREEN_UV);
	float luminance = dot(scene.rgb, vec3(0.299, 0.587, 0.114));
	vec3 softened = mix(scene.rgb, vec3(luminance), 0.24);
	vec3 warm = softened * vec3(1.12, 1.035, 0.86) + vec3(0.025, 0.012, 0.0);
	float edge = smoothstep(0.28, 0.76, distance(SCREEN_UV, vec2(0.5)));
	warm *= 1.0 - edge * 0.34;
	COLOR = vec4(mix(scene.rgb, warm, intensity), scene.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_safe_filter"]
shader = SubResource("Shader_safe_filter")
shader_parameter/intensity = 0.0

